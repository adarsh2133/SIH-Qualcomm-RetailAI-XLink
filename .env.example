RETAIL_AI_DB_PATH=data/retail_ai.db

# Central server binding. Use 0.0.0.0 on the LAN server; keep 127.0.0.1 for local-only use.
STORESENSE_API_HOST=0.0.0.0
STORESENSE_API_PORT=8080

# Four phone camera registration for the live OpenCV/YOLO path.
STORESENSE_CAMERA_IDS=entry-cam,queue-cam-1,queue-cam-2,shelf-cam-1

# MediaMTX workflow: each phone publishes to rtmp://<server-lan-ip>:1935/<camera-id>.
# The Python pipeline runs on that same server and reads the streams back locally.
STORESENSE_RTSP_BASE_URL=rtsp://127.0.0.1:8554
STORESENSE_RTMP_BASE_URL=rtmp://192.168.1.68:1935
STORESENSE_MEDIAMTX_API_URL=http://127.0.0.1:9997/v3/paths/list

# Direct phone-pull workflow, if your phone app exposes HTTP/MJPEG/RTSP instead of publishing to MediaMTX.
# Uncomment and replace only the URLs you want to read directly.
# STORESENSE_RTSP_URL_ENTRY_CAM=http://<phone-1-ip>:8080/video
# STORESENSE_RTSP_URL_QUEUE_CAM_1=http://<phone-2-ip>:8080/video
# STORESENSE_RTSP_URL_QUEUE_CAM_2=http://<phone-3-ip>:8080/video
# STORESENSE_RTSP_URL_SHELF_CAM_1=http://<phone-4-ip>:8080/video

STORESENSE_MODEL_PATH=yolo11n.pt

# Optional Raspberry Pi gateway queue endpoint. Leave empty until configured.
# STORESENSE_EDGE_GATEWAY_URL=http://<raspberry-pi-host>:<port>/api/v1/queue
STORESENSE_EDGE_GATEWAY_INTERVAL=1

# Only used once RabbitMQBus is swapped in for LocalEventBus (Phase 5) —
# must point at a self-hosted local broker, never a cloud-hosted one.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
