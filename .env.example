PORTAL_APP_NAME=PORTAL-XLINK
PORTAL_DB_PATH=data/retail.db
PORTAL_LOGS_PATH=logs/app.log
PORTAL_CPU_MODEL_PATH=models/cpu/model.onnx
# Validated ONNX artifact exported/compiled for the confirmed Qualcomm target.
PORTAL_QUALCOMM_MODEL_PATH=models/qualcomm/model.onnx
PORTAL_QUALCOMM_TARGET_DEVICE=
PORTAL_QUALCOMM_WEIGHTS_PATH=models/qualcomm/model.bin
PORTAL_QUALCOMM_LIBRARY_PATH=models/qualcomm/model.so
PORTAL_LABELS_PATH=models/qualcomm/labels.txt
PORTAL_HEADLESS=false
PORTAL_REFRESH_MS=2000
PORTAL_CAMERA_COUNT=4
# Required for normal production mode; leave empty to show NOT CONFIGURED.
# Example shape only (do not copy as a real endpoint):
# On Raspberry Pi with two USB webcams, set PORTAL_CAMERA_SOURCES=usb:0,usb:1.
PORTAL_CAMERA_SOURCES=
PORTAL_CAMERA_FRESHNESS_TIMEOUT_S=5
# OpenCV is the default. GStreamer requires an OpenCV build with GStreamer support.
PORTAL_RTSP_BACKEND=opencv
# Raspberry Pi deployment runs the exported NCNN model, not the training .pt.
PORTAL_INFERENCE_BACKEND=ncnn
PORTAL_YOLO_MODEL_PATH=models/yolo/best.pt
PORTAL_NCNN_MODEL_PATH=models/yolo/best_ncnn_model
PORTAL_YOLO_IMAGE_SIZE=416
PORTAL_YOLO_CONFIDENCE_THRESHOLD=0.25
PORTAL_YOLO_NMS_THRESHOLD=0.45
# The Pi service generates its own API credential and TLS identity on first start.
# PORTAL_API_TOKEN is only for deployments that explicitly manage credentials externally.
PORTAL_API_HOST=0.0.0.0
PORTAL_API_PORT=8765
PORTAL_API_TOKEN=
PORTAL_STATE_DIR=data/runtime
PORTAL_API_FRAME_MAX_SIZE=640
PORTAL_API_PREVIEW_FPS=5
PORTAL_INVENTORY_ALERT_RULES_JSON=
# Optional physical HD44780 16x2 customer display on the Raspberry Pi.
PORTAL_LCD_INTERFACE=auto
PORTAL_LCD_I2C_BUS=1
PORTAL_LCD_I2C_ADDRESS=auto
# For a parallel LCD, configure distinct BCM pins; RW must be tied to GND.
PORTAL_LCD_GPIO_JSON=
PORTAL_LCD_I2C_PCF8574_MAP_JSON={"rs":0,"rw":1,"enable":2,"backlight":3,"d4":4,"d5":5,"d6":6,"d7":7}
PORTAL_LCD_ROTATION_S=5
PORTAL_LCD_SCROLL_INTERVAL_S=0.45
PORTAL_LCD_ALERT_PRIORITY_JSON={"OUT_OF_STOCK":3,"CRITICAL_STOCK":2,"LOW_STOCK":1}
# Configure these on the PORTAL-XLINK client machine for `--backend remote`.
PORTAL_REMOTE_API_URL=https://storesense.local:8765
PORTAL_API_CERT_SHA256=
PORTAL_REMOTE_POLL_INTERVAL_S=1
QAI_HUB_API_TOKEN=
PORTAL_QAIHUB_TARGET_DEVICE=
PORTAL_QAIHUB_RUNTIME=
PORTAL_QAIHUB_MODEL=Detectron2-Detection
PORTAL_QAIHUB_CHECKPOINT=faster_rcnn_R_50_C4_1x
PORTAL_QAIHUB_SOURCE_MODEL=
PORTAL_QUALCOMM_MODEL_NAME=Detectron2-Detection
PORTAL_QUALCOMM_MODEL_CHECKPOINT=faster_rcnn_R_50_C4_1x
PORTAL_QUALCOMM_CONFIDENCE_THRESHOLD=0.25
PORTAL_QUALCOMM_NMS_THRESHOLD=0.45
PORTAL_SERIAL_PORT=
PORTAL_SERIAL_BAUDRATE=9600
PORTAL_GPIO_PINS=
